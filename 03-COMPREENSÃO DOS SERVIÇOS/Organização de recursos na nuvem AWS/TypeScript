import * as cdk from 'aws-cdk-lib';
import * as s3 from 'aws-cdk-lib/aws-s3';
import { Construct } from 'constructs';

export class MinhaInfraStack extends cdk.Stack {
  constructor(scope: Construct, id: string, props?: cdk.StackProps) {
    super(scope, id, props);

    // 1. Criação do Recurso (Ex: Bucket S3)
    const meuBucket = new s3.Bucket(this, 'BucketRecursos', {
      versioned: true,
      removalPolicy: cdk.RemovalPolicy.DESTROY,
    });

    // 2. Organização por Tags (Identificação de Custos e Ambiente)
    cdk.Tags.of(meuBucket).add('Ambiente', 'Desenvolvimento');
    cdk.Tags.of(meuBucket).add('CentroDeCusto', 'TI-Engenharia');
    cdk.Tags.of(meuBucket).add('Projeto', 'Portal');
  }
}
